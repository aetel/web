    <link href="https://en.goot.jp/js/slick/slick.css" rel="stylesheet">
    <script src="https://en.goot.jp/js/slick/slick.min.js" ></script>
    <link href="https://en.goot.jp/js/magnific-popup.css" rel="stylesheet">
